{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "pepeui",
  "homepage": "https://ui.example.com",
  "include": ["components/ui/registry.json"],
  "items": [
    {
      "name": "page-header",
      "type": "registry:block",
      "title": "Page Header",
      "description": "A page title, context and primary action.",
      "registryDependencies": ["button", "badge"],
      "files": [
        {
          "path": "registry/default/page-header/page-header.tsx",
          "type": "registry:component"
        }
      ]
    },
    {
      "name": "empty-state",
      "type": "registry:block",
      "title": "Empty State",
      "description": "An empty view with a next step.",
      "registryDependencies": ["button"],
      "files": [
        {
          "path": "registry/default/empty-state/empty-state.tsx",
          "type": "registry:component"
        }
      ]
    }
  ]
}
